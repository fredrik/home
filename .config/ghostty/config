# hello! this is fredrik's ghostty config.

font-size = 16
font-family = FiraCode Nerd Font Mono
font-feature = calt
font-feature = liga

theme = "Gruvbox Dark Hard"

# global hotkey
keybind = global:§=toggle_visibility

# pass Option as Alt
macos-option-as-alt = true

# don't ask to close tab
confirm-close-surface = false

# new windows and tabs start at home
working-directory = home

clipboard-paste-protection = false

notify-on-command-finish = never

# titles are set by hooks in ~/.zshrc ("<cmd> — <dir>") instead.
# ssh-env gives remote sessions TERM=xterm-256color and forwards COLORTERM.
# ssh-terminfo stays off: its tic-over-ssh probe is noisy against non-shell
# endpoints (shed's control plane) and its per-host cache goes stale when a
# VM is recreated; sheduntu ships the xterm-ghostty terminfo itself.
shell-integration-features = no-title,ssh-env
