# Simple prompt for clean copy-paste. Usage: psx [label|off]
# Without a label, shows the current path. With a label, shows the label.
# `psx off` restores starship.
if [[ "$1" == "off" ]]; then
  eval "$(starship init zsh)"
  return
fi
precmd_functions=(${precmd_functions:#prompt_starship_precmd})
preexec_functions=(${preexec_functions:#prompt_starship_preexec})
if [[ -n "$1" ]]; then
  PROMPT="[$1]: \$ "
else
  PROMPT='[%~]: $ '
fi
