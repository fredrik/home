[include]
    path = ~/.config/git/identity.inc

[includeIf "gitdir:~/code/knowit/"]
	path = ~/.config/git/work.inc

[core]
    autocrlf = input
    pager = delta
    editor = nvim

[init]
    defaultBranch = main

[color]
    diff = auto
    status = auto
    branch = auto

[diff]
    algorithm = patience

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    pager = moor
    true-color = always
    syntax-theme = gruvbox-dark
    line-numbers = true
    hyperlinks = true

    # Gruvbox Dark-matched diff colors: readable backgrounds, bright
    # foregrounds, and much stronger word-level emphasis.
    minus-style = syntax "#66302f"
    minus-emph-style = normal "#a3403a"
    minus-non-emph-style = syntax "#66302f"
    plus-style = syntax "#365a30"
    plus-emph-style = normal "#4e8f42"
    plus-non-emph-style = syntax "#365a30"

    file-style = bold "#fabd2f"
    file-decoration-style = "#665c54" ul
    hunk-header-style = "#83a598" bold
    hunk-header-decoration-style = "#665c54" box
    line-numbers-minus-style = "#fb4934"
    line-numbers-plus-style = "#b8bb26"
    line-numbers-zero-style = "#665c54"

[branch]
    autosetuprebase = always

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[rebase]
    autosquash = true

[log]
    mailmap = true

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = /Users/fredrik/.ssh/allowed_signers

[blame]
	usemailmap = true

[alias]
	prune-merged = !git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
