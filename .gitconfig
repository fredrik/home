[include]
    path = ~/.config/git/identity.inc

[includeIf "gitdir:~/code/knowit/"]
	path = ~/.config/git/work.inc

[core]
    autocrlf = input
    pager = delta
    editor = nvim

[init]
    defaultBranch = main

[color]
    diff = auto
    status = auto
    branch = auto

[diff]
    algorithm = patience

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    pager = moor

[branch]
    autosetuprebase = always

[push]
    default = current
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[rebase]
    autosquash = true

[log]
    mailmap = true

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
    allowedSignersFile = /Users/fredrik/.ssh/allowed_signers

[blame]
	usemailmap = true

[alias]
	prune-merged = !git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
