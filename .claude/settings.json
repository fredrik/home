{
  "env": {
    "GIT_CONFIG_PARAMETERS": "'commit.gpgsign=false' 'tag.gpgsign=false'"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false
  },
  "modelSettings": {
